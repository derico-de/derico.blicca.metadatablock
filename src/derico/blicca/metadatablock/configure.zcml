<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="derico.blicca.metadatablock">

  <i18n:registerTranslations directory="locales" />

  <include file="permissions.zcml" />

  <genericsetup:registerProfile
      name="default"
      title="Derico Blicca Metadatablock"
      description="Aurora Metadata blocks: show the content item&#39;s own metadata fields (title, description, dates, tags, ...) as blocks, singly or as a section"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="Derico Blicca Metadatablock (uninstall)"
      description="Uninstalls derico.blicca.metadatablock"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      />

  <genericsetup:importStep
      name="derico.blicca.metadatablock-uninstall"
      title="Derico Blicca Metadatablock uninstall"
      description="Uninstall derico.blicca.metadatablock"
      handler="derico.blicca.metadatablock.setuphandlers.uninstall"
      />


  <include package=".views" />


  <include package=".api" />

</configure>
