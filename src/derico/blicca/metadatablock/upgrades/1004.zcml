<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="derico.blicca.metadatablock">

  <genericsetup:registerProfile
      name="1004"
      title="derico.blicca.metadatablock: upgrade to 1004"
      directory="1004"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1003"
      destination="1004"
      profile="derico.blicca.metadatablock:default">

    <!-- Only the changed value, as in 1002: the records import keeps every
         other field of the existing records. -->
    <genericsetup:upgradeDepends
        title="Namespace the block types of the Metadata block records"
        description="Set the records' types to derico.metadata and derico.metadataSection (ADR 0025 in plone.blicca.auroraeditor)."
        import_profile="derico.blicca.metadatablock.upgrades:1004"
        import_steps="plone.app.registry"
        />

    <genericsetup:upgradeStep
        title="Rename the stored Metadata blocks"
        description="Rename every stored metadata and metadataSection block to derico.metadata and derico.metadataSection, in every JSON field (blocks, footer, ...), and reindex block_types."
        handler=".v1004.upgrade"
        />

  </genericsetup:upgradeSteps>

</configure>
