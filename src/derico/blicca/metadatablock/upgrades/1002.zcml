<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="derico.blicca.metadatablock">

  <genericsetup:registerProfile
      name="1002"
      title="derico.blicca.metadatablock: upgrade to 1002"
      directory="1002"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1001"
      destination="1002"
      profile="derico.blicca.metadatablock:default">

    <!-- Only the changed value, not a copy of the default registry.xml: the
         records import keeps every other field of the existing records. -->
    <genericsetup:upgradeDepends
        title="Declare block-api 2.0 on the metadata block records"
        description="The Plate 53 host stamps block-api 2.0; a 1.x declaration is skipped."
        import_profile="derico.blicca.metadatablock.upgrades:1002"
        import_steps="plone.app.registry"
        />

  </genericsetup:upgradeSteps>

</configure>
