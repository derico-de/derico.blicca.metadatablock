<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="derico.blicca.metadatablock">

  <!-- The dispatch convention (block add-on contract §5.1): the view name is
       `aurora-block-<@type>` and nothing else. `for="*"`: a metadata block
       can be authored on any blocks container, and on the site root. -->
  <browser:page
      name="aurora-block-metadata"
      for="*"
      class=".metadata_block_view.MetadataBlockView"
      template="metadata_block_view.pt"
      permission="zope2.View"
      layer="derico.blicca.metadatablock.interfaces.IDericoBliccaMetadatablockLayer"
      />

  <browser:page
      name="aurora-block-metadataSection"
      for="*"
      class=".metadata_section_block_view.MetadataSectionBlockView"
      template="metadata_section_block_view.pt"
      permission="zope2.View"
      layer="derico.blicca.metadatablock.interfaces.IDericoBliccaMetadatablockLayer"
      />

</configure>
